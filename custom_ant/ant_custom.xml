<mujoco model="ant">

    <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
    <option integrator="RK4" timestep="0.01"/>

    <!-- Initial joint positions (torso lifted to avoid sinking) -->
    <custom>
        <numeric name="init_qpos"
                 data="-10 -10 0.55  1 0 0 0
                       0 0
                       1 0
                       -1 0
                       -1 0
                       1 0"/>
    </custom>

    <default>
        <joint armature="1" damping="1" limited="true"/>
        <geom conaffinity="1" condim="3"
              density="5"
              friction="1 0.5 0.5"
              margin="0.01"
              rgba="0.8 0.6 0.4 1"/>
    </default>

    <asset>
        <texture builtin="gradient" height="100" width="100"
                 rgb1="1 1 1" rgb2="0 0 0" type="skybox"/>

        <texture builtin="flat" name="texgeom" type="cube"
                 height="128" width="128"
                 rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" random="0.01"/>

        <texture builtin="checker" name="texplane" type="2d"
                 height="100" width="100"
                 rgb1="0 0 0" rgb2="0.8 0.8 0.8"/>

        <material name="MatPlane" texture="texplane" texrepeat="60 60"
                  reflectance="0.5" shininess="1" specular="1"/>

        <material name="geom" texture="texgeom" texuniform="true"/>

        <!-- Heightfield storage -->
        <hfield name="terrain"
                nrow="100" ncol="100"
                size="40 40 4 0.1"/>
    </asset>

    <worldbody>
        
        <light name="light" pos="0 0 3" dir="0 0 -1"
               diffuse="1 1 1" specular="0.1 0.1 0.1"
               directional="true" />

        <!-- target visualization (position set dynamically in env based on terrain) -->
       <site name="target_site"
           pos="3 0 0.5"
           size="0.5 0.5 0.5"
           rgba="1 0 0 1"
           type="sphere"/>

        <!-- BACKUP COLLISION PLANE (prevents falling) -->
        <geom name="floor" type="plane"
              pos="0 0 0"
              size="40 40 1"
              contype="1"
              conaffinity="1"
              condim="3"
              friction="1 0.5 0.5"
              solref="0.02 1"
              solimp="0.9 0.95 0.002"/>

        <!-- COLLISION-ENABLED HEIGHTFIELD -->
        <geom name="terrain_geom"
              type="hfield"
              hfield="terrain"
              pos="0 0 0"
              size="20 20 5"
              rgba="0.8 0.9 0.8 1"
              contype="0"
              conaffinity="0"
              condim="3"
              friction="1 0.5 0.5"
              solref="0.02 1"
              solimp="0.9 0.95 0.002"/>
        <!-- X axis (红色，向右) -->
        <geom name="x_axis"
            type="capsule"
            fromto="0 0 0.05   5 0 0.05"
            size="0.02"
            rgba="1 0 0 1"
            contype="0"
            conaffinity="0"/>

        <!-- Y axis (绿色，向前) -->
        <geom name="y_axis"
            type="capsule"
            fromto="0 0 0.05   0 5 0.05"
            size="0.02"
            rgba="0 1 0 1"
            contype="0"
            conaffinity="0"/>

        <!-- Z axis (蓝色，向上) -->
        <geom name="z_axis"
            type="capsule"
            fromto="0 0 0   0 0 2"
            size="0.02"
            rgba="0 0 1 1"
            contype="0"
            conaffinity="0"/>

        <!-- =============== ANT BODY =============== -->
        <body name="torso" pos="0 0 0.75">

            <camera name="track" pos="0 -3 1" mode="fixed"/>

            <geom name="torso_geom" type="sphere" size="0.25"/>

            <joint name="root" type="free" pos="0 0 0"
                   armature="0" damping="0" limited="false"/>

            <!-- === FRONT LEFT LEG === -->
            <body name="front_left_leg" pos="0 0 0">
                <geom name="aux_1_geom" type="capsule" size="0.08"
                      fromto="0 0 0  0.2 0.2 0"/>
                <body name="aux_1" pos="0.2 0.2 0">
                    <joint name="hip_1" type="hinge" pos="0 0 0"
                           axis="0 0 1" range="-30 30"/>
                    <geom name="left_leg_geom" type="capsule" size="0.08"
                          fromto="0 0 0  0.2 0.2 0"/>
                    <body pos="0.2 0.2 0">
                        <joint name="ankle_1" type="hinge" pos="0 0 0"
                               axis="-1 1 0" range="30 70"/>
                        <geom name="left_ankle_geom" type="capsule" size="0.08"
                              fromto="0 0 0  0.4 0.4 0"/>
                    </body>
                </body>
            </body>

            <!-- === FRONT RIGHT LEG === -->
            <body name="front_right_leg" pos="0 0 0">
                <geom name="aux_2_geom" type="capsule" size="0.08"
                      fromto="0 0 0  -0.2 0.2 0"/>
                <body name="aux_2" pos="-0.2 0.2 0">
                    <joint name="hip_2" type="hinge" pos="0 0 0"
                           axis="0 0 1" range="-30 30"/>
                    <geom name="right_leg_geom" type="capsule" size="0.08"
                          fromto="0 0 0  -0.2 0.2 0"/>
                    <body pos="-0.2 0.2 0">
                        <joint name="ankle_2" type="hinge" pos="0 0 0"
                               axis="1 1 0" range="-70 -30"/>
                        <geom name="right_ankle_geom" type="capsule" size="0.08"
                              fromto="0 0 0  -0.4 0.4 0"/>
                    </body>
                </body>
            </body>

            <!-- === BACK LEFT LEG === -->
            <body name="back_left_leg" pos="0 0 0">
                <geom name="aux_3_geom" type="capsule" size="0.08"
                      fromto="0 0 0  -0.2 -0.2 0"/>
                <body name="aux_3" pos="-0.2 -0.2 0">
                    <joint name="hip_3" type="hinge" pos="0 0 0"
                           axis="0 0 1" range="-30 30"/>
                    <geom name="back_leg_geom" type="capsule" size="0.08"
                          fromto="0 0 0  -0.2 -0.2 0"/>
                    <body pos="-0.2 -0.2 0">
                        <joint name="ankle_3" type="hinge" pos="0 0 0"
                               axis="-1 1 0" range="-70 -30"/>
                        <geom name="third_ankle_geom" type="capsule" size="0.08"
                              fromto="0 0 0  -0.4 -0.4 0"/>
                    </body>
                </body>
            </body>

            <!-- === BACK RIGHT LEG === -->
            <body name="back_right_leg" pos="0 0 0">
                <geom name="aux_4_geom" type="capsule" size="0.08"
                      fromto="0 0 0  0.2 -0.2 0"/>
                <body name="aux_4" pos="0.2 -0.2 0">
                    <joint name="hip_4" type="hinge" pos="0 0 0"
                           axis="0 0 1" range="-30 30"/>
                    <geom name="rightback_leg_geom" type="capsule" size="0.08"
                          fromto="0 0 0  0.2 -0.2 0"/>
                    <body pos="0.2 -0.2 0">
                        <joint name="ankle_4" type="hinge" pos="0 0 0"
                               axis="1 1 0" range="30 70"/>
                        <geom name="fourth_ankle_geom" type="capsule" size="0.08"
                              fromto="0 0 0  0.4 -0.4 0"/>
                    </body>
                </body>
            </body>

        </body>

    </worldbody>

    <actuator>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="hip_4" gear="150"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="ankle_4" gear="150"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="hip_1" gear="150"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="ankle_1" gear="150"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="hip_2" gear="150"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="ankle_2" gear="150"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="hip_3" gear="150"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="ankle_3" gear="150"/>
</actuator>

</mujoco>
